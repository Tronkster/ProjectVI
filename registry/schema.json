{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectVI mod registry",
  "description": "Reference for mod authors. The launcher and CI validate with packages/shared/registry.js, which is the source of truth.",
  "type": "object",
  "required": ["version", "mods"],
  "properties": {
    "version": { "const": 1 },
    "mods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "author", "license", "versions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "author": { "type": "string", "minLength": 1, "maxLength": 64 },
          "description": { "type": "string", "maxLength": 300 },
          "license": { "type": "string", "description": "SPDX license id, e.g. MIT or GPL-3.0-only" },
          "homepage": { "type": "string", "pattern": "^https://" },
          "tags": { "type": "array", "maxItems": 8, "items": { "type": "string", "pattern": "^[a-z0-9-]{1,24}$" } },
          "versions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": ["version", "url", "sha256", "size"],
              "properties": {
                "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
                "url": { "type": "string", "pattern": "^https://" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "size": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
                "released": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
              }
            }
          }
        }
      }
    }
  }
}
