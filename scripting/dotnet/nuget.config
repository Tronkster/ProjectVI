<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org, regardless of feeds configured on the developer's machine. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Overrides any machine-wide source mapping: every package comes from nuget.org. -->
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
